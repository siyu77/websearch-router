{
  "name": "websearch-router-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "siyu77",
  "description": "A local websearch aggregation routing service (monorepo container)",
  "workspaces": [
    "packages/*",
    "packages/server/dashboard-ui"
  ],
  "scripts": {
    "dev": "npm --workspace @websearch/router-internal run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "pack": "npm run build && node scripts/pack.mjs",
    "prepublishOnly": "npm run pack && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.5.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
